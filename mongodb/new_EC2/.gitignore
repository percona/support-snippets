# Candidate run state (progress, scoreboard, timer, terminal transcripts)
state/level.txt
state/results.json
state/started_at.txt
state/history/

__pycache__/
*.pyc
.env.local

# basic-auth secrets (generated by ./gen-auth.sh) — never commit
nginx/auth/htpasswd
nginx/auth/htpasswd-interviewer

# SSH keys never belong in here. deploy.sh rsyncs this whole directory to the
# server, so a stray .pem would be copied to the box as well.
*.pem
*.key

# Local Claude Code settings (machine-specific, and they can capture command
# arguments verbatim, including passwords typed into a shell).
.claude/

# The percona.company fixture is generated, not committed. build.sh regenerates
# all three copies via tools/gen-company.py when they are missing (deterministic:
# same seed, same bytes).
exercises/*/company.json.tar.gz
