# /etc/my.cnf — lab default. Per-question setup.sh may amend this file (add a
# bad value, change a path, etc.) and restart mysqld.
#
# server_id and report_host are NOT set here. interview-prep writes them to
# /etc/my.cnf.d/99-node.cnf at boot, derived from the container's NODE_INDEX,
# so the three nodes never collide.

[mysqld]
datadir                  = /var/lib/mysql
socket                   = /var/lib/mysql/mysql.sock
log-error                = /var/log/mysql/mysqld.log
pid-file                 = /var/run/mysqld/mysqld.pid
port                     = 3306
bind-address             = 0.0.0.0

# Replication prerequisites, on for every node so any question can use them.
log_bin                  = /var/lib/mysql/binlog
relay_log                = /var/lib/mysql/relay-bin
binlog_format            = ROW
gtid_mode                = ON
enforce_gtid_consistency = ON
log_replica_updates      = ON

# Three of these run on one small box, so keep the footprint modest.
innodb_buffer_pool_size  = 128M
performance_schema       = ON

[client]
socket = /var/lib/mysql/mysql.sock

!includedir /etc/my.cnf.d/
